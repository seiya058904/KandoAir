{
  "name": "kandoair",
  "productName": "KandoAir",
  "version": "0.1.0",
  "description": "A lightweight, Windows-only pie menu based on Kando.",
  "private": true,
  "copyright": "Copyright © 2026 Simon Schneegans and KandoAir contributors",
  "scripts": {
    "build:web": "webpack --config packaging/webpack/webpack.config.ts --mode production",
    "watch:web": "webpack --config packaging/webpack/webpack.config.ts --mode development --watch",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "lint": "eslint .",
    "tscheck": "tsc --noEmit",
    "prettier": "prettier --check src",
    "format": "prettier --write src",
    "test": "ts-mocha test/**/*.spec.ts",
    "i18n": "npm run i18n:extract && npm run i18n:types",
    "i18n:extract": "i18next-cli extract",
    "i18n:types": "i18next-cli types"
  },
  "keywords": [],
  "author": {
    "name": "Simon Schneegans",
    "email": "code@simonschneegans.de"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@formkit/auto-animate": "0.11.0",
    "@types/chai": "^5.2.2",
    "@types/chroma-js": "^3.1.3",
    "@types/lodash.isequal": "^4.5.8",
    "@types/mocha": "^10.0.10",
    "@types/mousetrap": "^1.6.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/react-window": "^1.8.8",
    "chai": "^6.3.0",
    "chroma-js": "^3.3.0",
    "classnames": "^2.5.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "emojilib": "^4.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo-react": "^0.34.0",
    "eslint-plugin-prettier": "^5.5.7",
    "events": "^3.3.0",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.8",
    "i18next": "^26.4.0",
    "i18next-cli": "^1.95.1",
    "immer": "^11.2.10",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "lodash.isequal": "^4.5.0",
    "match-sorter": "^8.3.1",
    "material-symbols": "^0.49.0",
